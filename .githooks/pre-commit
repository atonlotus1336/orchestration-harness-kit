#!/usr/bin/env bash
# Leak guard: block committing any identity/host token (from .private-denylist) or a
# Projects path. Real tokens live ONLY in .private-denylist (gitignored), so this hook
# carries no identity and is itself shareable. Enable once:
#   git config core.hooksPath .githooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

DENY=""
[ -f "$ROOT/.private-denylist" ] && DENY=$(sed 's/\r$//' "$ROOT/.private-denylist" | grep -vE '^[[:space:]]*(#|$)' | paste -sd'|' - || true)

if [ -n "$DENY" ]; then
  code=0; grep -Eq "$DENY" /dev/null || code=$?
  if [ "$code" -gt 1 ]; then echo "BLOCKED: invalid privacy policy"; exit 1; fi
fi

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

leak=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  blob=$(git show ":$f" 2>/dev/null || true)
  if [ -n "$DENY" ] && printf '%s' "$blob" | grep -IniE "$DENY" >/dev/null 2>&1; then
    echo "LEAK in $f (denylisted token; contents withheld)"
    leak=1
  fi
done <<< "$staged"

printf '%s\n' "$staged" | grep -qiE 'projects/' && { echo "LEAK: a Projects path is staged"; leak=1; }
# Fail-closed: a MISSING denylist must never silently allow a commit. If the guard
# cannot run at full strength, block until the recipient supplies their own list.
if [ -z "$DENY" ]; then
  echo "BLOCKED: no .private-denylist found — the identity guard cannot run."
  echo "Create .private-denylist (your real identity/host tokens; gitignored) or run"
  echo "sync-shareable.sh (it scrubs), then retry. Fail-closed by design."
  leak=1
fi

if [ "$leak" -ne 0 ]; then
  echo "----------------------------------------------------------------"
  echo "COMMIT BLOCKED. Re-run the sync (it scrubs) or fix by hand before committing."
  exit 1
fi
echo "pre-commit tripwire clean."

# Doc-count gate: when the guards suite or a doc that states its test count is
# staged, run tools/check-doc-counts.py against the STAGED copies, so a partial
# stage is judged on what the commit will actually contain.
COUNT_FILES='^(README\.md|AGENTS\.md|KIT-MAINTENANCE\.md|tools/check-doc-counts\.py|modules/guards/.*)$'
if printf '%s\n' "$staged" | grep -qE "$COUNT_FILES"; then
  PY=""
  for candidate in python python3; do
    if "$candidate" -c 'import sys' >/dev/null 2>&1; then PY="$candidate"; break; fi
  done
  if [ -z "$PY" ]; then
    echo "COMMIT BLOCKED: the doc-count check needs Python (python or python3 on PATH)."
    exit 1
  fi
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  git ls-files | grep -E "$COUNT_FILES" \
    | git checkout-index --stdin --prefix="$tmp/"
  if ! "$PY" "$tmp/tools/check-doc-counts.py"; then
    echo "----------------------------------------------------------------"
    echo "COMMIT BLOCKED. A doc states a dry-run-gate test count the suite does not report."
    echo "Update the lines listed above, stage them, and commit again."
    exit 1
  fi
fi
