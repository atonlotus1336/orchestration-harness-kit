{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host-owned remote worktree binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "job_id",
    "task_id",
    "goal_id",
    "contract_sha256",
    "harness",
    "session_id",
    "target_id",
    "target_policy_sha256",
    "repository",
    "base_commit",
    "worktree",
    "declared_paths",
    "route_fingerprint",
    "runtime_fingerprint",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "goal_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "harness": {
      "enum": [
        "hermes",
        "codex",
        "claude-code",
        "moa",
        "cursor",
        "dsh",
        "pi",
        "opencode",
        "antigravity"
      ]
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "target_policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "worktree": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "declared_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "route_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
