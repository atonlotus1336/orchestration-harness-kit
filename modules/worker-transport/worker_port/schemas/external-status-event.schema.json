{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host-bound external status observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "event_id",
    "binding_id",
    "job_id",
    "harness",
    "session_id",
    "external_run_id",
    "sequence",
    "observed_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "harness": {
      "enum": [
        "hermes",
        "codex",
        "claude-code",
        "moa",
        "cursor",
        "dsh",
        "pi",
        "opencode",
        "antigravity"
      ]
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "external_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "waiting",
        "done",
        "failed",
        "cancelled"
      ]
    }
  }
}
