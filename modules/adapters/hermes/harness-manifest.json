{
  "schema": "lapart.harness-manifest.v2",
  "name": "hermes-os-reference",
  "display_name": "Hermes OS Reference Adapter",
  "harness_version": "2.0.1",
  "adapter": {
    "language": "python",
    "entrypoint": "hermes_adapter.py",
    "class": "HermesOSAdapter",
    "sdk_version": 2
  },
  "protocol_versions": [1, 2],
  "operations": {
    "mode": "all",
    "include": [],
    "exclude": []
  },
  "capabilities": {
    "streaming": true,
    "tools": true,
    "skills": true,
    "mcp": true,
    "memory": true,
    "retrieval": true
  },
  "configuration": {
    "config_reference": "recipient://hermes/profile",
    "data_reference": "recipient://hermes/data",
    "authentication": null
  },
  "lifecycle": {
    "initialize": "initialize",
    "shutdown": "shutdown",
    "readiness": "readiness_signal",
    "rollback": "rollback_signal"
  }
}
