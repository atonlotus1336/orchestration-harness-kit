{
  "schema": "lapart.harness-manifest.v2",
  "name": "opencode",
  "display_name": "OpenCode Universal Adapter",
  "harness_version": "2.0.0",
  "adapter": {
    "language": "python",
    "entrypoint": "opencode_adapter.py",
    "class": "OpenCodeAdapter",
    "sdk_version": 2
  },
  "protocol_versions": [1, 2],
  "operations": {
    "mode": "all",
    "include": [],
    "exclude": []
  },
  "capabilities": {
    "streaming": true,
    "tools": true,
    "skills": true,
    "mcp": true,
    "memory": true,
    "retrieval": true
  },
  "configuration": {
    "config_reference": "recipient://opencode/plugin",
    "data_reference": "recipient://opencode/data",
    "authentication": null
  },
  "lifecycle": {
    "initialize": "initialize",
    "shutdown": "shutdown",
    "readiness": "readiness_signal",
    "rollback": "rollback_signal"
  }
}
