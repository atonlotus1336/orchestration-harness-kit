{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/provider-route-lease-v1.json",
  "title": "Provider route lease and backend admission contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_reference", "model_reference", "route_class", "profiles", "lease", "backend"],
  "properties": {
    "provider_reference": {"type": "string", "minLength": 1},
    "model_reference": {"type": "string", "minLength": 1},
    "route_class": {"enum": ["provider_free", "subscription", "pay_per_token"]},
    "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auth_modes", "usage_contexts", "subscription_delegation_allowed", "retention_classes", "compliance_classes", "terms_status", "terms_reference"],
      "properties": {
        "auth_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["provider_free", "local", "subscription", "api_key", "workload_identity"]}},
        "usage_contexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["internal", "distributable_product"]}},
        "subscription_delegation_allowed": {"type": "boolean"},
        "retention_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["unknown", "ephemeral", "standard", "zero"]}},
        "compliance_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}},
        "terms_status": {"enum": ["current", "stale", "unverified"]},
        "terms_reference": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_reference", "task_shapes", "durable_resume", "estimated_overhead_ms", "backend_version", "minimum_version", "maximum_version_exclusive", "qualification_status", "requalification_triggers"],
      "properties": {
        "backend_reference": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "task_shapes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["general", "coding", "computer_use", "long_running_workflow", "domain_workflow"]}},
        "durable_resume": {"type": "boolean"},
        "estimated_overhead_ms": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "backend_version": {"oneOf": [{"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"}, {"type": "null"}]},
        "minimum_version": {"oneOf": [{"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"}, {"type": "null"}]},
        "maximum_version_exclusive": {"oneOf": [{"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"}, {"type": "null"}]},
        "qualification_status": {"enum": ["qualified", "stale", "unqualified"]},
        "requalification_triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}}
      }
    }
  }
}
