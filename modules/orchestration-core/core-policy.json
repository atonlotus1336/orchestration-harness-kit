{
  "schema": "lapart.core-policy.v2",
  "protocol_versions": [1, 2],
  "routing_policy": "gated",
  "t2_actual_lane": "T3",
  "subscription_first": true,
  "pay_per_token_allowed": false,
  "external_effects_require_approval": true,
  "production_activation_allowed": false,
  "required_promotion_gates": ["quality", "calls", "latency", "rollback", "tokens"],
  "context": {
    "maximum_growth_percent": 5.0,
    "tiers": {
      "atomic": {"maximum_bytes": 32768, "maximum_provider_calls": 3},
      "standard": {"maximum_bytes": 131072, "maximum_provider_calls": 4},
      "complex": {"maximum_bytes": 262144, "maximum_provider_calls": 5},
      "high_risk": {"maximum_bytes": 524288, "maximum_provider_calls": 6}
    },
    "required_components": ["system_prompt", "authority_context"]
  },
  "activation_states": ["inactive", "shadow", "review", "production"]
}
