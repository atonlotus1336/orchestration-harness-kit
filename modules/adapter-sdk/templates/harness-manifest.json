{
  "schema": "lapart.harness-manifest.v2",
  "name": "example-harness",
  "display_name": "Example Harness",
  "harness_version": "1.0.0",
  "adapter": {
    "language": "python",
    "entrypoint": "adapter.py",
    "class": "ExampleHarnessAdapter",
    "sdk_version": 2
  },
  "protocol_versions": [1, 2],
  "operations": {
    "mode": "all",
    "include": [],
    "exclude": []
  },
  "capabilities": {
    "streaming": true,
    "tools": true,
    "skills": true,
    "mcp": true,
    "memory": true,
    "retrieval": true
  },
  "configuration": {
    "config_reference": "environment:LAPART_HARNESS_CONFIG",
    "data_reference": "recipient-local-data",
    "authentication": {
      "kind": "environment",
      "reference": "LAPART_HARNESS_AUTH_REFERENCE"
    }
  },
  "lifecycle": {
    "initialize": "initialize",
    "shutdown": "shutdown",
    "readiness": "readiness_signal",
    "rollback": "rollback_signal"
  }
}
