{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lapart/harness-manifest-v2.schema.json",
  "title": "LapArt Universal Harness Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "display_name",
    "harness_version",
    "adapter",
    "protocol_versions",
    "operations",
    "capabilities",
    "configuration",
    "lifecycle"
  ],
  "properties": {
    "schema": {"const": "lapart.harness-manifest.v2"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "display_name": {"type": "string", "minLength": 1},
    "harness_version": {"type": "string", "minLength": 1},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "entrypoint", "class", "sdk_version"],
      "properties": {
        "language": {"enum": ["python"]},
        "entrypoint": {"type": "string", "minLength": 1},
        "class": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "sdk_version": {"const": 2}
      }
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "enum": [1, 2]}
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "include", "exclude"],
      "properties": {
        "mode": {"enum": ["all", "subset"]},
        "include": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclude": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streaming", "tools", "skills", "mcp", "memory", "retrieval"],
      "properties": {
        "streaming": {"type": "boolean"},
        "tools": {"type": "boolean"},
        "skills": {"type": "boolean"},
        "mcp": {"type": "boolean"},
        "memory": {"type": "boolean"},
        "retrieval": {"type": "boolean"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_reference", "data_reference", "authentication"],
      "properties": {
        "config_reference": {"type": "string", "minLength": 1},
        "data_reference": {"type": "string", "minLength": 1},
        "authentication": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reference"],
              "properties": {
                "kind": {"enum": ["environment", "secret_store", "managed_identity"]},
                "reference": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialize", "shutdown", "readiness", "rollback"],
      "properties": {
        "initialize": {"const": "initialize"},
        "shutdown": {"const": "shutdown"},
        "readiness": {"const": "readiness_signal"},
        "rollback": {"const": "rollback_signal"}
      }
    }
  }
}
