{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://__PRIVATE_TOKEN_02__.local/contracts/remote-client-evidence.schema.json",
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fingerprint": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"},
    "base": {
      "type": "object",
      "properties": {
        "schema_version": {"const": "1.0"},
        "run_id": {"$ref": "#/$defs/id"},
        "report_id": {"$ref": "#/$defs/id"},
        "client_id": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "pattern": "^http://[0-9.]+:[0-9]+$"},
        "key_status": {"enum": ["MISSING", "MISMATCH", "ENROLLED"]},
        "observed_at": {"type": "integer", "minimum": 0},
        "status": {"enum": ["READY", "FAIL", "UNVERIFIED"]},
        "go_eligible": {"type": "boolean"}
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "report_id", "client_id", "endpoint", "key_status", "observed_at", "status", "go_eligible", "challenge_issued", "reason"],
      "properties": {
        "schema_version": {"const": "1.0"}, "run_id": {"$ref": "#/$defs/id"}, "report_id": {"$ref": "#/$defs/id"},
        "client_id": {"type": "string", "minLength": 1}, "endpoint": {"type": "string"},
        "key_status": {"enum": ["MISSING", "MISMATCH", "ENROLLED"]}, "observed_at": {"type": "integer", "minimum": 0},
        "status": {"const": "UNVERIFIED"}, "go_eligible": {"const": false}, "challenge_issued": {"const": false},
        "reason": {"enum": ["KEY_MISSING", "KEY_MISMATCH", "SIGNING_PREREQUISITE_UNAVAILABLE"]}
      }
    },
    {
      "allOf": [{"$ref": "#/$defs/base"}],
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "report_id", "client_id", "endpoint", "key_status", "observed_at", "status", "go_eligible", "challenge_issued", "key_fingerprint", "namespace", "principal", "payload_sha256", "signature_base64", "observation"],
      "properties": {
        "schema_version": {"const": "1.0"}, "run_id": {"$ref": "#/$defs/id"}, "report_id": {"$ref": "#/$defs/id"},
        "client_id": {"type": "string", "minLength": 1}, "endpoint": {"type": "string"},
        "key_status": {"const": "ENROLLED"}, "observed_at": {"type": "integer", "minimum": 0},
        "status": {"enum": ["READY", "FAIL"]}, "go_eligible": {"type": "boolean"}, "challenge_issued": {"const": true},
        "key_fingerprint": {"$ref": "#/$defs/fingerprint"}, "namespace": {"const": "hermes-prime-attester-v1"},
        "principal": {"const": "hermes-prime-attester@__PRIVATE_TOKEN_02__"}, "payload_sha256": {"$ref": "#/$defs/sha"},
        "signature_base64": {"type": "string", "minLength": 1},
        "observation": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "http_status", "endpoint", "body_sha256", "observed_at"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL"]}, "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
            "endpoint": {"type": "string"}, "body_sha256": {"$ref": "#/$defs/sha"}, "observed_at": {"type": "integer", "minimum": 0}
          }
        }
      },
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"if": {"properties": {"status": {"const": "READY"}}}, "then": {"properties": {"go_eligible": {"const": true}, "observation": {"properties": {"status": {"const": "PASS"}}}}}},
        {"if": {"properties": {"status": {"const": "FAIL"}}}, "then": {"properties": {"go_eligible": {"const": false}, "observation": {"properties": {"status": {"const": "FAIL"}}}}}}
      ]
    }
  ]
}
