{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://__PRIVATE_TOKEN_02__.local/contracts/prime-model-route.schema.json",
  "title": "G-authority-bound Hermes to Prime model route",
  "$defs": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_at", "context_window", "max_output_tokens", "supports_streaming", "supports_tools", "supports_developer_role", "supports_reasoning_effort"],
      "properties": {
        "verified_at": {"type": "string", "format": "date-time"},
        "context_window": {"type": "integer", "minimum": 1024},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "supports_streaming": {"type": "boolean"},
        "supports_tools": {"type": "boolean"},
        "supports_developer_role": {"type": "boolean"},
        "supports_reasoning_effort": {"type": "boolean"}
      }
    },
    "credential": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "environment_variable"],
          "properties": {
            "source": {"const": "runtime-environment"},
            "environment_variable": {"enum": ["OLLAMA_API_KEY", "OLLAMA_CLOUD_API_KEY", "HERMES_PRIME_LOCAL_PLACEHOLDER"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "provider_id"],
          "properties": {
            "source": {"const": "hermes-provider-config"},
            "provider_id": {"enum": ["ollama-cloud", "ollama-local", "local-ollama", "ollama-cloud-local"]}
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "base_url", "api", "compatibility", "credential"],
      "properties": {
        "provider": {"enum": ["ollama", "ollama-cloud"]},
        "model": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:.*\\S)?$"},
        "base_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "api": {"const": "openai-completions"},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "credential": {"$ref": "#/$defs/credential"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "active_profile", "authority", "captured_at", "run_id", "provider", "model", "base_url", "api", "compatibility", "credential"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "active_profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "source_sha256"],
      "properties": {
        "source_path": {"type": "string", "pattern": "^(?:__WINDOWS_WORKSPACE__|__WSL_WORKSPACE__)/.+"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "captured_at": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "provider": {"$ref": "#/$defs/route/properties/provider"},
    "model": {"$ref": "#/$defs/route/properties/model"},
    "base_url": {"$ref": "#/$defs/route/properties/base_url"},
    "api": {"$ref": "#/$defs/route/properties/api"},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "credential": {"$ref": "#/$defs/credential"},
    "explicit_fallback": {"$ref": "#/$defs/route"}
  }
}
