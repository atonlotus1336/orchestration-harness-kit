{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "repository_fingerprint", "scope", "pipeline", "verdict", "rollout_mode", "authoritative", "base_identity", "head_or_snapshot_identity", "declared_paths", "declared_path_set_sha256", "policy_fingerprint", "reviewer_fingerprints", "finding_counts", "metrics", "findings"],
  "properties": {
    "schema_version": {"const": "1.0"}, "run_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"},
    "repository_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "scope": {"enum": ["checkpoint", "plan", "phase", "system"]}, "pipeline": {"enum": ["S0", "S1", "S2", "S3", "S4"]}, "verdict": {"enum": ["PASS", "FINDINGS", "INCONCLUSIVE"]},
    "rollout_mode": {"enum": ["shadow", "advisory", "enforced_phase", "manual_system"]}, "authoritative": {"type": "boolean"}, "base_identity": {"type": "string", "minLength": 1}, "head_or_snapshot_identity": {"type": "string", "minLength": 1},
    "declared_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "declared_path_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "policy_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer_fingerprints": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "finding_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["context_bytes", "model_calls", "tool_calls", "elapsed_ms"], "properties": {"context_bytes": {"type": "integer", "minimum": 0}, "model_calls": {"type": "integer", "minimum": 0}, "tool_calls": {"type": "integer", "minimum": 0}, "elapsed_ms": {"type": "integer", "minimum": 0}, "estimated_input_tokens": {"type": "integer", "minimum": 0}, "actual_input_tokens": {"type": ["integer", "null"], "minimum": 0}, "cache_reuse_bytes": {"type": "integer", "minimum": 0}}},
    "findings": {"type": "array", "items": {"$ref": "adaptive-code-review-finding.schema.json"}},
    "parallel_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduler_source_sha256", "catalog_sha256", "selected_members", "lens_bindings", "career_assignments", "grant_sha256s", "prompts_sha256", "budget", "desired_count", "admitted_count", "observed_count", "frozen_triggers", "career_shadow_results", "convergence_owner"],
      "properties": {
        "scheduler_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "selected_members": {"$ref": "#/definitions/boundedStrings"},
        "lens_bindings": {"type": "object", "additionalProperties": {"$ref": "#/definitions/boundedStrings"}},
        "career_assignments": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
        "grant_sha256s": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "prompts_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "budget": {"type": "object"},
        "desired_count": {"type": "integer", "minimum": 0},
        "admitted_count": {"type": "integer", "minimum": 0},
        "observed_count": {"type": "integer", "minimum": 0},
        "frozen_triggers": {"$ref": "#/definitions/boundedStrings"},
        "career_shadow_results": {
          "type": "object",
          "additionalProperties": {"$ref": "#/definitions/careerShadowResult"}
        },
        "convergence_owner": {"const": "Controller/Runner"}
      }
    },
    "change_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "declared_paths", "acceptance_criteria", "semantic_assertions", "bugfix_intent", "regression_test_expected", "regression_test_evidence", "regression_test_exemption", "alternative_verification", "cleanup_boundary_enabled"],
      "properties": {
        "objective": {"type": "string", "minLength": 1, "maxLength": 4096},
        "declared_paths": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "acceptance_criteria": {"$ref": "#/definitions/boundedStrings"},
        "semantic_assertions": {"$ref": "#/definitions/boundedStrings"},
        "bugfix_intent": {"type": "boolean"},
        "regression_test_expected": {"type": "boolean"},
        "regression_test_evidence": {"type": ["object", "null"]},
        "regression_test_exemption": {"type": ["string", "null"]},
        "alternative_verification": {"$ref": "#/definitions/boundedStrings"},
        "cleanup_boundary_enabled": {"type": "boolean"}
      }
    },
    "change_contract_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual_changed_paths", "changed_paths_outside_declared_scope", "deterministic_test_results", "static_analysis_results", "required_regression_evidence_present", "regression_test_exemption_present", "alternative_verification_present", "semantic_hunk_analysis_performed", "model_calls", "inconclusive"],
      "properties": {
        "actual_changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "changed_paths_outside_declared_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "deterministic_test_results": {"type": "array", "items": {"$ref": "#/definitions/deterministicResult"}},
        "static_analysis_results": {"type": "array", "items": {"$ref": "#/definitions/deterministicResult"}},
        "required_regression_evidence_present": {"type": "boolean"},
        "regression_test_exemption_present": {"type": "boolean"},
        "alternative_verification_present": {"type": "boolean"},
        "semantic_hunk_analysis_performed": {"const": false},
        "model_calls": {"const": 0},
        "inconclusive": {"type": "boolean"}
      }
    },
    "evaluation_hooks": {"type": "object"}
  },
  "definitions": {
    "boundedStrings": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "careerShadowResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "disposition", "finding_ids", "check_ids"],
      "properties": {
        "status": {"enum": ["not_run", "completed", "inconclusive"]},
        "disposition": {"enum": ["disabled", "accepted", "rejected", "unresolved"]},
        "finding_ids": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "check_ids": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "deterministicResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_status", "phase", "acceptance_criterion"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "exit_status": {"type": "integer"},
        "phase": {"type": "string", "minLength": 1},
        "acceptance_criterion": {"type": ["string", "null"]}
      }
    }
  }
}
